# Godot 4
.godot/
.import/
/android/

# The gs-* addons are separate repositories and are linked in, never committed.
# For local development, symlink them from a sibling checkout:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# bootstrap.sh derives this project's dependencies from the lines below, so a
# dependency added here is a dependency it links on the next run.
/addons/gs_core
/addons/gs_profile
/addons/gs_combat
/addons/gs_weapon
/addons/gs_net
/addons/gs_player
/addons/gs_player_controller
/addons/gs_player_char
/addons/gs_physics
/addons/gs_audio
/addons/gs_animation
/addons/gs_sim

# Exports
build/
export.cfg
export_presets.cfg
*.translation

# Screenshots are evidence for a review, not assets.
/screenshots/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/

# Blender runs the art-src scripts and leaves bytecode beside them.
__pycache__/

# Sibling addons linked for local suites (absolute links must never be tracked; CI resolves them from addons.lock):
/addons/godot-sqlite
/addons/gs_bot
/addons/gs_bot_record
/addons/gs_sim
/addons/gs_sql
/.gs-pack

