# Godot 4
.godot/
.import/
/android/

# The dot-* addons are separate repositories and are linked in, never committed.
# For local development, symlink them from a sibling checkout:
#   ln -s ../../dot-core/addons/dot_core addons/dot_core
# bootstrap.sh derives this project's dependencies from the lines below, so a
# dependency added here is a dependency it links on the next run.
/addons/dot_core
/addons/dot_profile
/addons/dot_combat
/addons/dot_weapon
/addons/dot_net
/addons/dot_player
/addons/dot_player_controller
/addons/dot_player_char
/addons/dot_physics
/addons/dot_audio

# Exports
build/
export.cfg
export_presets.cfg
*.translation

# Screenshots are evidence for a review, not assets.
/screenshots/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/

# Blender runs the art-src scripts and leaves bytecode beside them.
__pycache__/
